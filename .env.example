# --- local dev (docker compose) ---
DATABASE_URL=postgres://ong:ong@localhost:5432/ong
GOTENBERG_URL=http://localhost:3000
GOTENBERG_USERNAME=ong
GOTENBERG_PASSWORD=ongongong

# S3-compatible object storage — local = MinIO, Railway = Object Storage bucket
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ong
S3_ACCESS_KEY=ong
S3_SECRET_KEY=ongongong
S3_FORCE_PATH_STYLE=true

# auth (better-auth) — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789
# = origin ที่ browser เปิดแอป — dev คือ vite :5173 (proxy /api → api :8787 ส่ง Origin เดิมไป)
# ถ้าตั้งเป็น :8787 login จากหน้าเว็บจะโดน 403 "forbidden origin" · production = โดเมนของแอป
BETTER_AUTH_URL=http://localhost:5173

PORT=8787

# tests (apps/api) — สร้าง/ลบ database ชั่วคราวผ่าน connection นี้
TEST_DATABASE_URL=postgres://ong:ong@localhost:5432/postgres
