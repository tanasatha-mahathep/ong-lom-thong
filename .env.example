# --- local dev (docker compose) ---
DATABASE_URL=postgres://ong:ong@localhost:5432/ong
GOTENBERG_URL=http://localhost:3000
GOTENBERG_USERNAME=ong
GOTENBERG_PASSWORD=ongongong

# หัวใบรับซื้อ — ข้อมูลกิจการที่พิมพ์บนใบทุกใบ (ไม่ใช่ค่าลับ) · จากหน้า "ข้อมูลบริษัท" ของระบบเดิม
# ค่ามีช่องว่างต้องครอบ "" (make โหลด .env ด้วย sh) · ไม่มีโทรสาร = เว้นว่าง (ใบพิมพ์ "-")
COMPANY_NAME="โอเอ็นจี หลอมทอง"
COMPANY_ADDRESS="156/7 ถนนพังงา ตำบลตลาดใหญ่ อำเภอเมืองภูเก็ต จังหวัดภูเก็ต 83000"
COMPANY_TEL=0654249514
COMPANY_FAX=
COMPANY_TAX_ID=3839900461751
# ลายน้ำบน PDF/ใบบนจอ — ทุก environment ยกเว้น production · เว้นว่าง = ไม่มีลายน้ำ
RECEIPT_WATERMARK="ตัวอย่าง — ระบบทดสอบ ไม่ใช่ใบรับซื้อจริง"
# Sarabun สำหรับ PDF — dev (pnpm dev รันใน apps/api) ใช้ของ apps/web · image ของ api ใช้ค่าเริ่มต้น public/fonts
PDF_FONT_DIR=../web/public/fonts
# ราคาอ้างอิงสมาคมค้าทองคำ (แสดง + เติมค่าเริ่มต้นในหน้าตั้งราคา · ผู้จัดการต้องกดบันทึกเอง)
# none = ปิด (ค่าเริ่มต้น) · goldtraders-html = หน้า HTML ของสมาคม · thai-gold-api = JSON บุคคลที่สาม
GOLD_REFERENCE_PROVIDER=none
# GOLD_REFERENCE_URL=https://classic.goldtraders.or.th/default.aspx

# S3-compatible object storage — local = RustFS (docker compose `s3`), Railway = Object Storage bucket
# local ใช้ :9100 ไม่ใช่ :9000 — php-fpm ของ Homebrew ฟัง 127.0.0.1:9000 อยู่
S3_ENDPOINT=http://localhost:9100
S3_REGION=auto
S3_BUCKET=ong
S3_ACCESS_KEY=ong
S3_SECRET_KEY=ongongong
S3_FORCE_PATH_STYLE=true

# auth (better-auth) — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-0123456789
# = origin ที่ browser เปิดแอป — dev คือ vite :5173 (proxy /api → api :8787 ส่ง Origin เดิมไป)
# ถ้าตั้งเป็น :8787 login จากหน้าเว็บจะโดน 403 "forbidden origin" · production = โดเมนของแอป
BETTER_AUTH_URL=http://localhost:5173

PORT=8787

# Sentry — ไม่บังคับ · เว้นว่าง = ไม่ส่ง error ออกนอกเครื่อง (dev ปกติไม่ตั้ง) · DSN จาก Project Settings → Client Keys
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# SENTRY_ENVIRONMENT=development

# tests (apps/api) — สร้าง/ลบ database ชั่วคราวผ่าน connection นี้
TEST_DATABASE_URL=postgres://ong:ong@localhost:5432/postgres
